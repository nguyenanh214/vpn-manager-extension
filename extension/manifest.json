{
  "manifest_version": 3,
  "name": "VPN Manager",
  "version": "1.0.0",
  "description": "Định tuyến từng domain qua VPN OpenVPN riêng, không ảnh hưởng phần còn lại của máy.",
  "permissions": ["proxy", "storage", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VPN Manager"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
